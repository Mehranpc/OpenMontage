            "license": {
              "type": "object",
              "required": [
                "name",
                "url",
                "downloadedAt"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "description": "The licence page, so the claim is checkable by a human."
                },
                "downloadedAt": {
                  "type": "string",
