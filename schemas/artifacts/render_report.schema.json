{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/render_report",
  "title": "Render Report",
  "description": "Output report produced by the Composer agent after rendering.",
  "type": "object",
  "required": [
    "version",
    "outputs"
  ],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "format",
          "resolution",
          "duration_seconds"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string"
          },
          "resolution": {
            "type": "string"
          },
          "fps": {
            "type": "number"
          },
          "duration_seconds": {
            "type": "number",
            "minimum": 0
          },
          "file_size_bytes": {
            "type": "integer"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{64}$",
            "description": "Digest of the exact rendered bytes; Persian checkpoint writes recompute and verify it."
          },
          "platform_target": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "render_time_seconds": {
      "type": "number",
      "minimum": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "render_grammar": {
      "type": "string",
      "description": "Which renderer family was used for this render",
      "enum": [
        "explainer-data",
        "explainer-teacher",
        "cinematic-trailer",
        "documentary-montage",
        "product-reveal",
        "screen-demo",
        "presenter",
        "animation-first",
        "persian-footage"
      ]
    },
    "slideshow_risk_score": {
      "type": "object",
      "description": "Final slideshow risk assessment",
      "properties": {
        "average": {
          "type": "number"
        },
        "verdict": {
          "type": "string"
        }
      }
    },
    "decision_log_ref": {
      "type": "string",
      "description": "Path to the project's cumulative decision log"
    },
    "final_review_ref": {
      "type": "string",
      "description": "Path or inline reference to the final_review artifact produced by post-render self-review. Provides durable audit linkage between the render output and its quality inspection."
    },
    "output_path": {
      "type": "string",
      "description": "Convenience pointer at the primary output. Redundant with outputs[0].path and kept only so a reader does not have to index into the array."
    },
    "composition_id": {
      "type": "string",
      "description": "Composition actually rendered, e.g. PersianFootageVertical. Recorded because format and composition can disagree, and the disagreement is invisible in the MP4."
    },
    "format": {
      "type": "string",
      "enum": [
        "vertical",
        "landscape",
        "square"
      ],
      "description": "Frame orientation of the render, for cross-checking against the brief."
    },
    "duration_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Measured output duration, from ffprobe rather than from the plan."
    },
    "shot_count": {
      "type": "integer",
      "minimum": 0
    },
    "attributions": {
      "type": "array",
      "description": "Credit line per clip used. Both Pexels and Pixabay require attribution, so a render whose attributions do not cover every clip has shipped a licence violation.",
      "items": {
        "type": "string"
      }
    },
    "moment_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Typographic moments painted (persian-footage). 7-9 for a 60-second video: the 0.55 coverage ceiling and the reading floor together force fewer, richer, slower moments, and 12-15 cannot fit under the ceiling at honest durations (see MAX_TEXT_COVERAGE in lib/persian_moments.py)."
    },
    "text_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction of the runtime carrying on-screen type (persian-footage). The single number distinguishing a typographic edit from a caption track, and invisible in the MP4 without measuring it. Above 0.55 the moment audit fails the edit."
    },
    "subtitle_path": {
      "type": "string",
      "description": "Sidecar .srt written beside the output from the narration's word timings. Absent in silent mode, which has no speech to subtitle."
    },
    "subtitle_advisories": {
      "type": "array",
      "description": "Readability notes on the sidecar subtitles. Advisories rather than failures on purpose: an over-speed cue is a property of how fast the narrator spoke, and the honest remedy is a shorter script, not a blocked delivery.",
      "items": {
        "type": "string"
      }
    },
    "caption_mode": {
      "type": "string",
      "enum": [
        "sidecar_only",
        "burned_captions",
        "hybrid"
      ],
      "description": "Caption surface actually used by the Persian candidate."
    },
    "burned_caption_count": {
      "type": "integer",
      "minimum": 0,
      "description": "Runtime-derived approved-script caption cues painted into the MP4. Zero for sidecar_only."
    },
    "delivery_status": {
      "type": "string",
      "enum": [
        "final_candidate",
        "approved",
        "rejected"
      ],
      "description": "Lifecycle of a rendered candidate; final_candidate awaits the user’s one post-render review."
    },
    "human_visual_approval": {
      "type": "boolean",
      "description": "False for automation. Only explicit approval of the rendered output may set it true."
    },
    "persian_text_verified": {
      "type": "boolean",
      "description": "False on an automatically produced Persian final candidate. It may become true only after the user approves that exact render and all automated text measurements pass; verification_notes records those measurements and their limits."
    },
    "verification_frames": {
      "type": "array",
      "description": "Extracted frames the numeric verification was run against, so the measurements can be re-run or disputed.",
      "items": {
        "type": "string"
      }
    },
    "caption_verification_frames": {
      "type": "array",
      "description": "Post-render caption samples retained for burned_captions/hybrid review. Persian final review requires at least entry/mid/exit examples from the actual MP4.",
      "items": {
        "type": "string"
      }
    },
    "music_mixed": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object"
    },
    "retention_audit": {
      "type": "object",
      "description": "Timeline-derived Persian short-form retention audit from lib.persian_retention. Stores measurable cadence facts; semantic judgements remain separate.",
      "properties": {
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "advisories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "first3Seconds": {
          "type": "object"
        },
        "averageVisualEventSeconds": {
          "type": "number",
          "minimum": 0
        },
        "longestVisualEvent": {
          "type": "object"
        },
        "meaningfulChangesPer15Seconds": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "weakEmptyIntervals": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "textOnlySeconds": {
          "type": "number",
          "minimum": 0
        },
        "endingTextOnlySeconds": {
          "type": "number",
          "minimum": 0
        },
        "cutGrammar": {
          "type": "object"
        },
        "judgementRequired": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observableEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "version",
              "kind",
              "provenance",
              "scope",
              "observation",
              "canProve",
              "cannotProve"
            ],
            "properties": {
              "version": {
                "type": "string",
                "const": "1.0"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "object",
                "required": [
                  "domain",
                  "source"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "enum": [
                      "authored_timeline",
                      "rendered_pixels",
                      "semantic_review"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "scope": {
                "type": "object",
                "required": [
                  "startSeconds"
                ],
                "properties": {
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "canProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cannotProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "problems",
        "advisories",
        "first3Seconds",
        "averageVisualEventSeconds",
        "longestVisualEvent",
        "meaningfulChangesPer15Seconds",
        "weakEmptyIntervals",
        "textOnlySeconds",
        "endingTextOnlySeconds",
        "cutGrammar",
        "judgementRequired"
      ],
      "additionalProperties": false
    },
    "silent_watch_audit": {
      "type": "object",
      "description": "Muted-viewer review performed on the rendered candidate. This is a judgement, not inferred from timeline metrics.",
      "properties": {
        "main_point_understood": {
          "type": "boolean"
        },
        "hook_direction_understood": {
          "type": "boolean"
        },
        "conclusion_understood": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "main_point_understood",
        "hook_direction_understood",
        "conclusion_understood",
        "notes"
      ],
      "additionalProperties": false
    },
    "cut_rhythm": {
      "type": "string",
      "description": "Final-review judgement of cut rhythm after watching the rendered candidate."
    },
    "caption_readability": {
      "type": "string",
      "description": "Final-review judgement of caption/subtitle readability and competition with typographic moments."
    },
    "strongest_scene": {
      "type": "string"
    },
    "weakest_scene": {
      "type": "string"
    },
    "hook_strength": {
      "type": "string",
      "enum": [
        "weak",
        "acceptable",
        "strong"
      ]
    },
    "resolution_strength": {
      "type": "string",
      "enum": [
        "weak",
        "acceptable",
        "strong"
      ]
    },
    "post_render_motion_qa": {
      "type": "object",
      "description": "Pixel-derived anti-slideshow audit over the finished MP4. Persian final review requires passed=true; warnRuns are review advisories, failRuns block delivery.",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "sampleFps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "nearStaticDeltaMax": {
          "type": "number",
          "minimum": 0
        },
        "warningRunSeconds": {
          "type": "number",
          "minimum": 0
        },
        "failRunSeconds": {
          "type": "number",
          "minimum": 0
        },
        "deltas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "atSeconds",
              "meanAbsDelta"
            ],
            "properties": {
              "atSeconds": {
                "type": "number",
                "minimum": 0
              },
              "meanAbsDelta": {
                "type": "number",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "warnRuns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "failRuns": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "elapsedSeconds": {
          "type": "number",
          "minimum": 0
        },
        "observableEvidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "version",
              "kind",
              "provenance",
              "scope",
              "observation",
              "canProve",
              "cannotProve"
            ],
            "properties": {
              "version": {
                "type": "string",
                "const": "1.0"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "object",
                "required": [
                  "domain",
                  "source"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "enum": [
                      "authored_timeline",
                      "rendered_pixels",
                      "semantic_review"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "scope": {
                "type": "object",
                "required": [
                  "startSeconds"
                ],
                "properties": {
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "canProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cannotProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "required": [
        "passed",
        "sampleFps",
        "nearStaticDeltaMax",
        "warningRunSeconds",
        "failRunSeconds",
        "deltas",
        "warnRuns",
        "failRuns",
        "elapsedSeconds"
      ],
      "additionalProperties": false
    },
    "quality_evidence": {
      "type": "object",
      "description": "Normalized authored/rendered observable evidence. Optional for legacy reports; when present final review verifies it against the raw retention and motion sources before adding semantic cold-view evidence.",
      "required": [
        "version",
        "evidence",
        "openingSummary",
        "diagnostics"
      ],
      "properties": {
        "version": {
          "type": "string",
          "const": "1.0"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "version",
              "kind",
              "provenance",
              "scope",
              "observation",
              "canProve",
              "cannotProve"
            ],
            "properties": {
              "version": {
                "type": "string",
                "const": "1.0"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "provenance": {
                "type": "object",
                "required": [
                  "domain",
                  "source"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "enum": [
                      "authored_timeline",
                      "rendered_pixels",
                      "semantic_review"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false
              },
              "scope": {
                "type": "object",
                "required": [
                  "startSeconds"
                ],
                "properties": {
                  "startSeconds": {
                    "type": "number",
                    "minimum": 0
                  },
                  "endSeconds": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              },
              "observation": {
                "type": "string",
                "minLength": 1
              },
              "canProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "cannotProve": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "details": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        },
        "openingSummary": {
          "type": "object",
          "required": [
            "windowSeconds",
            "authoredPostStartShotOrRevealChange",
            "renderedPixelMotionObserved",
            "coldViewComprehension",
            "relationship",
            "statements"
          ],
          "properties": {
            "windowSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "authoredPostStartShotOrRevealChange": {
              "type": "boolean"
            },
            "renderedPixelMotionObserved": {
              "type": "boolean"
            },
            "coldViewComprehension": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "relationship": {
              "type": "string",
              "enum": [
                "different_provenance_not_contradictory",
                "authored_change_not_observed_in_rendered_pixels",
                "different_provenance_consistent",
                "different_provenance_both_absent"
              ]
            },
            "statements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "severity",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "info",
                  "warning",
                  "blocking"
                ]
              },
              "message": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
