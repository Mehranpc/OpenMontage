4149391edea3671c422a79d51ed470fc555e44ff139e454f2b00fe","text":"تا حالا شده بعد از یه قرار خوب، گوشی دستت باشه و ندونی الان پیام بدی یا صبر کنی؟ پژوهشگرا دقیقاً همین سؤال رو آزمایش کردن: بعد از قرار اول، چه زمانی برای فرستادن اولین پیام بهتره؟ در این مطالعه، ۵۴۳ نفر تصور کردند یک قرار اول داشتند و بعد، طرف مقابل یا بلافاصله پیام می‌داد، یا صبح روز بعد، یا دو روز بعد. جالب‌ترین نتیجه این بود که بیشترین تمایل به ادامه رابطه وقتی دیده شد که پیام صبح روز بعد می‌رسید. پیام فوری، علاقه رو واضح‌تر نشون می‌داد، اما فرستنده کمی نیازمندتر به نظر می‌رسید. از اون طرف، دو روز صبر کردن هم کمکی نکرد؛ افراد احساس شیمی و انگیزه کمتری برای ادامه ارتباط داشتند و طرف مقابل رو کمتر قابل‌اعتماد می‌دیدند. یعنی حداقل در این آزمایش، «دیر پیام بده تا مشتاق به نظر نرسی» استراتژی خیلی خوبی نبود. حالا تو بگو: بعد از قرار اول، همون شب پیام می‌دی، فردا صبح یا صبر می‌کنی؟"},"semanticPosterStack":{"authoritativeHookSha256":"a021d6ab26bc7bcbf2f2f4d73f17ae4bd303e904f8210ef8f4d30fedca18c0c6","authoritativeHookText":"تا حالا شده بعد از یه قرار خوب، گوشی دستت باشه و ندونی الان پیام بدی یا صبر کنی؟","phrases":[{"role":"setup","text":"تا حالا شده"},{"role":"bridge","text":"بعد از یه قرار خوب،"},{"role":"subject_hero","text":"گوشی دستت باشه"},{"role":"payoff","text":"و ندونی الان پیام بدی یا صبر کنی؟"}],"version":"1.0"}},"persian":{"audio":{"musicDuckVolume":0.229087,"narration":"/Users/operator/OpenMontage/projects/first-date-message-timing/inputs/narration.mp3","wordTimings":[{"end":0.12666666666666668,"start":0.0,"word":"تا"},{"end":0.38,"start":0.12666666666666668,"word":"حالا"},{"end":0.5974999999999999,"start":0.38,"word":"شده"},{"end":0.815,"start":0.5974999999999999,"word":"بعد"},{"end":0.96,"start":0.815,"word":"از"},{"end":1.1199999999999999,"start":0.96,"word":"یه"},{"end":1.44,"start":1.1199999999999999,"word":"قرار"},{"end":1.76,"start":1.44,"word":"خوب،"},{"end":2.2,"start":1.76,"word":"گوشی"},{"end":2.42,"start":2.2,"word":"دستت"},{"end":2.9,"start":2.42,"word":"باشه"},{"end":2.9819999999999